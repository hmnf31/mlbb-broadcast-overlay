{
  "name": "mlbb-broadcast-overlay",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev --config cloudflare/wrangler.jsonc",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --config cloudflare/wrangler.jsonc",
    "d1:schema:local": "wrangler d1 execute mlbb-db --local --config cloudflare/wrangler.jsonc --file=cloudflare/migrations/0001_init.sql",
    "d1:schema:remote": "wrangler d1 execute mlbb-db --remote --config cloudflare/wrangler.jsonc --file=cloudflare/migrations/0001_init.sql",
    "test:control": "node scripts/test-control-panel.mjs",
    "test:profiles": "node scripts/test-multi-profile.mjs",
    "test:ocr": "node scripts/test-ocr-guard.mjs",
    "test:overlay": "node scripts/test-overlay-render.mjs",
    "test:d1": "node scripts/test-d1.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "wrangler": "4.147.0"
  }
}
