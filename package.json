{
  "name": "mlbb-broadcast-overlay",
  "private": true,
  "type": "module",
  "scripts": {
    "build:matrix": "node scripts/build-hero-matrix.mjs",
    "build:cloudflare": "npm run build:matrix && node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev --config cloudflare/wrangler.jsonc",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --config cloudflare/wrangler.jsonc",
    "d1:schema:local": "wrangler d1 execute mlbb-db --local --config cloudflare/wrangler.jsonc --file=cloudflare/migrations/0001_init.sql",
    "d1:schema:remote": "wrangler d1 execute mlbb-db --remote --config cloudflare/wrangler.jsonc --file=cloudflare/migrations/0001_init.sql",
    "test:control": "node scripts/test-control-panel.mjs",
    "test:profiles": "node scripts/test-multi-profile.mjs",
    "test:ocr": "node scripts/test-ocr-guard.mjs",
    "test:ocr-timer": "node scripts/test-ocr-timer.mjs && node scripts/test-ocr-parse.mjs",
    "test:overlay": "node scripts/test-overlay-render.mjs",
    "test:markup": "node scripts/check-overlay-markup.cjs",
    "test:d1": "node scripts/test-d1.mjs",
    "test:draft": "node scripts/test-draft-analytics.mjs && node scripts/test-draft-overlay.mjs",
    "test:result-modes": "node scripts/test-result-modes.mjs",
    "test:verify": "node scripts/test-verify-panel.mjs",
    "test:home": "node scripts/test-home-flow.mjs",
    "test:all": "npm run test:markup && npm run test:draft && npm run test:result-modes && npm run test:verify && npm run test:home && npm run test:ocr && npm run test:ocr-timer && npm run test:control && npm run test:overlay"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "wrangler": "4.147.0"
  }
}
